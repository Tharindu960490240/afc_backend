
# Whose public holidays stop the working-day clock (Tasmania and Victoria)
HOLIDAY_JURISDICTIONS=TAS,VIC

# --- Only for Vercel (free demo hosting) ---
# DB_SSL=true
# TRUST_PROXY=1
# DB_POOL_MAX=3
# UPLOAD_DIR=/tmp/storage

# --- Email over HTTPS (use when the host blocks SMTP, e.g. Vercel) ---
# EMAIL_MODE=brevo
# BREVO_API_KEY=your-api-key
# EMAIL_FROM=a sender address verified in Brevo
# LOGO_URL=https://your-frontend-address/path-to-logo.png
